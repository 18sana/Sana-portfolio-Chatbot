# -----------------------------------------------------------------------------
# Backend environment — copy to backend/.env
# -----------------------------------------------------------------------------

APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/ai_portfolio
REDIS_URL=redis://localhost:6379/0

ADMIN_API_KEY=dev-admin-key-change-me

MAX_UPLOAD_BYTES=5000000
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_SESSION_PER_MINUTE=30
RATE_LIMIT_JD_PER_MINUTE=10
RETRIEVAL_TOP_K=8

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Alternatives: openai + gpt-4o-mini, anthropic + claude-sonnet-4-5
LLM_API_BASE=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_BASE=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_MODEL=
EMBEDDING_FALLBACK_API_BASE=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
