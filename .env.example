# -----------------------------------------------------------------------------
# Local docker-compose (Postgres + Redis)
# Copy to .env in the repo root for compose variable substitution.
# -----------------------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=ai_portfolio
POSTGRES_PORT=5432
REDIS_PORT=6379

# Shared connection strings (backend also documents these in backend/.env.example)
# DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/ai_portfolio
# REDIS_URL=redis://localhost:6379/0
